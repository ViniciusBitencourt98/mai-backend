generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

// Technical persistence probe only. Not a business entity.
model TechnicalProbe {
  id        String   @id @default(uuid()) @db.Uuid
  marker    String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("technical_probes")
}
