generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

// Technical persistence probe only. Not a business entity.
model TechnicalProbe {
  id        String   @id @default(uuid()) @db.Uuid
  marker    String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("technical_probes")
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(254)
  name         String           @db.VarChar(100)
  passwordHash String           @map("password_hash")
  disabledAt   DateTime?        @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  preferences  UserPreferences?
  sessions     Session[]
  projects     Project[]
  notes        Note[]

  @@map("users")
}

model UserPreferences {
  userId       String  @id @map("user_id") @db.Uuid
  timezone     String  @default("America/Bahia") @db.VarChar(100)
  emailEnabled Boolean @default(false) @map("email_enabled")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthThrottle {
  key       String   @id @db.VarChar(100)
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_throttles")
}


enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String?       @db.Char(7)
  startDate   DateTime?     @map("start_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  ownerId     String        @map("owner_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, updatedAt])
  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@index([ownerId, createdAt])
  notes       Note[]
  @@unique([id, ownerId])
  @@map("projects")
}


model Note {
  id         String    @id @default(uuid()) @db.Uuid
  title      String    @db.VarChar(200)
  content    String    @default("")
  tags       String[]  @default([])
  ownerId    String    @map("owner_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project    Project?  @relation(fields: [projectId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerId, archivedAt, updatedAt])
  @@index([ownerId, createdAt])
  @@index([ownerId, updatedAt])
  @@index([ownerId, projectId])
  @@index([tags], type: Gin)
  @@map("notes")
}
