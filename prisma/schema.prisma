generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

// Technical persistence probe only. Not a business entity.
model TechnicalProbe {
  id        String   @id @default(uuid()) @db.Uuid
  marker    String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("technical_probes")
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(254)
  name         String           @db.VarChar(100)
  passwordHash String           @map("password_hash")
  disabledAt   DateTime?        @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  reminderRules ReminderRule[]
  notificationOutbox NotificationOutbox[]
  preferences  UserPreferences?
  sessions     Session[]
  projects     Project[]
  events       Event[]
  tasks        Task[]
  notes        Note[]
  publications Publication[]
  decupages    Decupage[]

  @@map("users")
}

model UserPreferences {
  userId       String  @id @map("user_id") @db.Uuid
  timezone     String  @default("America/Bahia") @db.VarChar(100)
  emailEnabled Boolean @default(false) @map("email_enabled")
  dailyDigestEnabled Boolean @default(false) @map("daily_digest_enabled")
  dailyDigestTime String @default("08:00") @map("daily_digest_time") @db.Char(5)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthThrottle {
  key       String   @id @db.VarChar(100)
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_throttles")
}


enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String?       @db.Char(7)
  startDate   DateTime?     @map("start_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  ownerId     String        @map("owner_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, updatedAt])
  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@index([ownerId, createdAt])
  tasks       Task[]
  events      Event[]
  notes       Note[]
  publications Publication[]
  decupages   Decupage[]
  @@unique([id, ownerId])
  @@map("projects")
}


model Note {
  id         String    @id @default(uuid()) @db.Uuid
  title      String    @db.VarChar(200)
  content    String    @default("")
  tags       String[]  @default([])
  ownerId    String    @map("owner_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project    Project?  @relation(fields: [projectId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerId, archivedAt, updatedAt])
  @@index([ownerId, createdAt])
  @@index([ownerId, updatedAt])
  @@index([ownerId, projectId])
  @@index([tags], type: Gin)
  @@map("notes")
}

model Decupage {
  id         String    @id @default(uuid()) @db.Uuid
  title      String    @db.VarChar(200)
  description    String?
  tags       String[]  @default([])
  ownerId    String    @map("owner_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  segments   DecupageSegment[]
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project    Project?  @relation(fields: [projectId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerId, archivedAt, updatedAt])
  @@index([ownerId, createdAt])
  @@index([ownerId, updatedAt])
  @@index([ownerId, projectId])
  @@index([tags], type: Gin)
  @@map("decupages")
}

model DecupageSegment {
  id          String   @id @default(uuid()) @db.Uuid
  decupageId  String   @map("decupage_id") @db.Uuid
  position    Int
  startMs     Int      @map("start_ms")
  endMs       Int?     @map("end_ms")
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  decupage    Decupage @relation(fields: [decupageId], references: [id], onDelete: Cascade)

  // Deferred uniqueness is defined in SQL to allow atomic position swaps.
  @@index([decupageId, position])
  @@map("decupage_segments")
}


enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(200)
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  startDate   DateTime?    @map("start_date") @db.Date
  dueDate     DateTime?    @map("due_date") @db.Date
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  ownerId     String       @map("owner_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(3)
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)
  subtasks    Subtask[]
  recurrenceRules TaskRecurrence[]

  @@index([ownerId, status, dueDate])
  @@index([ownerId, priority])
  @@index([ownerId, dueDate])
  @@index([ownerId, projectId])
  @@index([ownerId, createdAt])
  @@index([ownerId, updatedAt])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  title     String   @db.VarChar(200)
  completed Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Deferred uniqueness is preserved in the SQL migration.
  @@index([taskId, position])
  @@map("subtasks")
}


enum TaskRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM_DAYS
}

enum TaskRecurrenceState {
  ACTIVE
  PAUSED
  ENDED
}

model TaskRecurrence {
  id        String @id @default(uuid()) @db.Uuid
  taskId    String @map("task_id") @db.Uuid
  version   Int
  frequency TaskRecurrenceFrequency
  interval  Int @default(1)
  startDate DateTime @map("start_date") @db.Date
  weekdays  Int[] @default([])
  endDate   DateTime? @map("end_date") @db.Date
  count     Int?
  timezone  String @db.VarChar(100)
  state     TaskRecurrenceState @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrences TaskOccurrence[]

  @@unique([taskId, version])
  @@map("task_recurrences")
}

model TaskOccurrence {
  ruleId String @map("rule_id") @db.Uuid
  date DateTime @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  rule TaskRecurrence @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  events TaskOccurrenceEvent[]

  @@id([ruleId, date])
  @@map("task_occurrences")
}

model TaskOccurrenceEvent {
  id String @id @default(uuid()) @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  date DateTime @db.Date
  completed Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  occurrence TaskOccurrence @relation(fields: [ruleId, date], references: [ruleId, date], onDelete: Cascade)

  @@index([ruleId, date, createdAt])
  @@map("task_occurrence_events")
}


model Event {
 id String @id @default(uuid()) @db.Uuid
 title String @db.VarChar(200)
 description String?
 startAt DateTime @map("start_at") @db.Timestamptz(3)
 endAt DateTime @map("end_at") @db.Timestamptz(3)
 timezone String @db.VarChar(100)
 location String? @db.VarChar(1000)
 ownerId String @map("owner_id") @db.Uuid
 projectId String? @map("project_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
 owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 project Project? @relation(fields:[projectId,ownerId],references:[id,ownerId],onDelete:Restrict,onUpdate:Restrict)
 recurrenceRules EventRecurrence[]
 @@index([ownerId,startAt,endAt])
 @@index([ownerId,endAt])
 @@index([ownerId,projectId])
 @@map("events")
}

model EventRecurrence {
 id String @id @default(uuid()) @db.Uuid
 eventId String @map("event_id") @db.Uuid
 version Int
 frequency TaskRecurrenceFrequency
 interval Int @default(1)
 startDate DateTime @map("start_date") @db.Date
 weekdays Int[] @default([])
 endDate DateTime? @map("end_date") @db.Date
 count Int?
 timezone String @db.VarChar(100)
 state TaskRecurrenceState @default(ACTIVE)
 anchorStartAt DateTime @map("anchor_start_at") @db.Timestamptz(3)
 anchorEndAt DateTime @map("anchor_end_at") @db.Timestamptz(3)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
 exceptions EventException[]
 @@unique([eventId,version])
 @@map("event_recurrences")
}

model EventException {
 ruleId String @map("rule_id") @db.Uuid
 date DateTime @db.Date
 title String @db.VarChar(200)
 description String?
 location String? @db.VarChar(1000)
 startAt DateTime @map("start_at") @db.Timestamptz(3)
 endAt DateTime @map("end_at") @db.Timestamptz(3)
 cancelled Boolean @default(false)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
 rule EventRecurrence @relation(fields:[ruleId],references:[id],onDelete:Cascade)
 @@id([ruleId,date])
 @@index([ruleId,startAt,endAt])
 @@map("event_exceptions")
}


enum PublicationPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  LINKEDIN
  OTHER
}

enum PublicationFormat {
  SHORT_VIDEO
  LONG_VIDEO
  REELS
  STORIES
  CAROUSEL
  IMAGE
  TEXT
  OTHER
}

enum PublicationStatus {
  IDEA
  PLANNED
  IN_PRODUCTION
  READY
  PUBLISHED
  CANCELLED
}

model Publication {
  id          String @id @default(uuid()) @db.Uuid
  title       String @db.VarChar(200)
  caption     String?
  platform    PublicationPlatform
  format      PublicationFormat
  status      PublicationStatus @default(IDEA)
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  externalUrl String? @map("external_url") @db.VarChar(2000)
  notes       String?
  projectId   String? @map("project_id") @db.Uuid
  ownerId     String @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project     Project? @relation(fields: [projectId, ownerId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerId, archivedAt, scheduledAt])
  @@index([ownerId, scheduledAt])
  @@index([ownerId, updatedAt])
  @@index([ownerId, platform, scheduledAt])
  @@index([ownerId, format, scheduledAt])
  @@index([ownerId, status, scheduledAt])
  @@index([ownerId, projectId])
  @@map("publications")
}


enum NotificationSourceType {
  TASK
  EVENT
  PUBLICATION
}

enum NotificationType {
  TASK_REMINDER
  EVENT_REMINDER
  PUBLICATION_REMINDER
  DAILY_DIGEST
}

enum NotificationStatus {
  PENDING
  RESERVED
  PUBLISHED
  SENT
  FAILED
  CANCELLED
}

enum NotificationResult {
  CREATED
  RESERVED
  QUEUED
  PROVIDER_ACCEPTED
  FAILED
  CANCELLED
}

enum NotificationFailureCategory {
  NETWORK
  PROVIDER_REJECTED
  INTERNAL
  LEASE_EXPIRED
  STALE
  USER_CANCELLED
}

model ReminderRule {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  sourceType NotificationSourceType @map("source_type")
  sourceId String @map("source_id") @db.Uuid
  leadMinutes Int @map("lead_minutes")
  enabled Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  intentions NotificationOutbox[]
  @@unique([ownerId,sourceType,sourceId])
  @@unique([id,ownerId])
  @@map("reminder_rules")
}

model NotificationOutbox {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  type NotificationType
  sourceType NotificationSourceType? @map("source_type")
  sourceId String? @map("source_id") @db.Uuid
  reminderRuleId String? @map("reminder_rule_id") @db.Uuid
  ruleVersion Int? @map("rule_version")
  sourceVersion String @map("source_version") @db.Char(64)
  recurrenceRuleId String? @map("recurrence_rule_id") @db.Uuid
  recurrenceVersion Int? @map("recurrence_version")
  occurrenceDate DateTime? @map("occurrence_date") @db.Date
  digestDate DateTime? @map("digest_date") @db.Date
  timezone String @db.VarChar(100)
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(3)
  status NotificationStatus @default(PENDING)
  idempotencyKey String @map("idempotency_key") @db.Char(64)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  reservedFrom NotificationStatus? @map("reserved_from")
  attemptCount Int @default(0) @map("attempt_count")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
  failedAt DateTime? @map("failed_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  lastError NotificationFailureCategory? @map("last_error")
  providerMessageId String? @map("provider_message_id") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  reminderRule ReminderRule? @relation(fields:[reminderRuleId,ownerId],references:[id,ownerId],onDelete:Restrict,onUpdate:Restrict)
  deliveryLog NotificationDeliveryLog[]
  @@unique([ownerId,idempotencyKey])
  @@unique([ownerId,type,digestDate])
  @@unique([id,ownerId])
  @@index([status,scheduledAt])
  @@index([status,leaseUntil])
  @@index([ownerId,scheduledAt,id])
  @@index([ownerId,reminderRuleId,status])
  @@map("notification_outbox")
}

model NotificationDeliveryLog {
  id String @id @default(uuid()) @db.Uuid
  outboxId String @map("outbox_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  status NotificationStatus
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(3)
  result NotificationResult
  errorCategory NotificationFailureCategory? @map("error_category")
  providerMessageId String? @map("provider_message_id") @db.VarChar(200)
  outbox NotificationOutbox @relation(fields:[outboxId,ownerId],references:[id,ownerId],onDelete:Restrict,onUpdate:Restrict)
  @@index([ownerId,outboxId,attemptedAt,id])
  @@map("notification_delivery_log")
}

// Internal bounded Cron maintenance progress; not notification delivery state.
model NotificationMaintenanceCursor {
  name String @id @db.VarChar(50)
  lastRuleId String? @map("last_rule_id") @db.Uuid
  @@map("notification_maintenance_cursors")
}
