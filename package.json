{
  "name": "mai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:remote": "vitest run --config vitest.remote.config.ts",
    "build:validation": "wrangler deploy --config wrangler.validation.jsonc --env development --dry-run --outdir dist/validation"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
