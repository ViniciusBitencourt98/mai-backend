{
  "name": "mai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:remote": "vitest run --config vitest.remote.config.ts",
    "build:validation": "wrangler deploy --config wrangler.validation.jsonc --env development --dry-run --outdir dist/validation",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "node scripts/prisma-migrate.mjs dev",
    "prisma:migrate:apply": "node scripts/prisma-migrate.mjs deploy",
    "prisma:migrate:status": "node scripts/prisma-migrate.mjs status",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12",
    "wrangler": "4.161.0",
    "dotenv": "18.0.10"
  }
}
