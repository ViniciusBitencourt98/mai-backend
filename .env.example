# Somente exemplos fictícios. Nunca versionar credenciais reais.
# Usar exclusivamente banco/branch Neon de desenvolvimento autorizado.
# Host com -pooler: aplicação. Host direto: ferramentas de migration.
DATABASE_URL=postgresql://USER:PASSWORD@ep-DEVELOPMENT-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-DEVELOPMENT.REGION.aws.neon.tech/DB?sslmode=require
# Confirmação local explícita; verificar a branch no painel Neon antes de usar.
MAI_DATABASE_ENV=development
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Non-secret auth settings; use the same values in .dev.vars for Wrangler.
AUTH_ENV=development
AUTH_PUBLIC_ORIGIN=http://localhost:8787
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
