# Comma-separated exact origins. This file contains no secrets.
# Copy to .dev.vars to allow the local frontend explicitly.
CORS_ALLOWED_ORIGIN="http://localhost:5173"
# Opcional: colar somente a URL pooled da branch Neon de desenvolvimento.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-DEVELOPMENT-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL pertence ao CLI em .env, nunca é necessário no Worker.

# Auth local: insecure cookie is accepted ONLY on explicit loopback origins.
AUTH_ENV="development"
AUTH_PUBLIC_ORIGIN="http://localhost:8787"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"
# Remote HTTPS defaults to Secure + SameSite=Lax. Cross-site requires explicit None.

# Jobs internos: filas são bindings Wrangler, nunca URLs/segredos.
NOTIFICATION_BATCH_SIZE="20"
NOTIFICATION_LEASE_SECONDS="60"
# Cron a cada minuto; sem banco, apenas HTTP /health e testes isolados funcionam.

# Envio real fica desabilitado por padrão. Não habilitar em testes Code First.
EMAIL_DELIVERY_ENABLED="false"
# APPLICATION_URL="https://app.example.invalid"
# GMAIL_FROM deve ser a caixa autorizada ou alias validado.
# Configurar GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN e GMAIL_FROM
# exclusivamente em configuração local ignorada/secrets Workers; não versionar valores.
